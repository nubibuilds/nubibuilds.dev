---
/**
 * One picture of a case study, from either source:
 *   - a file in the repository (relative path in the frontmatter): optimised by Astro at build
 *     time (modern format, several sizes, known dimensions);
 *   - an image hosted elsewhere (https://…): used as it is. Its dimensions are not known at
 *     build time, so pass `width` and `height` when you can; without them the picture is
 *     fitted into a 16:9 box so the page does not jump while it loads.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  class?: string;
  /** Shown as the caption by ProseEnhance when the picture is inside `.prose`. */
  title?: string;
  /** Local images only: the widths to generate, and the `sizes` hint for the browser. */
  widths?: number[];
  sizes?: string;
  /** Remote images only: the real pixel size of the file. */
  width?: number;
  height?: number;
  /** Load immediately with high priority (for the picture at the top of a page). */
  priority?: boolean;
}

const { src, alt, class: className, title, widths, sizes, width, height, priority = false } = Astro.props;
const sized = Boolean(width && height);
---

{
  typeof src === 'string' ? (
    <img
      class:list={[className, 'remote-img', !sized && 'no-size']}
      src={src}
      alt={alt}
      title={title}
      width={sized ? width : undefined}
      height={sized ? height : undefined}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : undefined}
      referrerpolicy="no-referrer"
    />
  ) : priority ? (
    <Image class={className} src={src} alt={alt} title={title} widths={widths} sizes={sizes} priority />
  ) : (
    <Image class={className} src={src} alt={alt} title={title} widths={widths} sizes={sizes} loading="lazy" />
  )
}

<style is:global>
  /* A remote picture of unknown size: reserve a 16:9 box and fit the whole picture inside it. */
  .case-cover.no-size,
  .prose.gallery img.no-size {
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: var(--surface);
  }
  /* A remote picture of known size scales like a local one. */
  .remote-img:not(.no-size) {
    height: auto;
  }
  .wc-img.remote-img {
    height: 100%;
  }
</style>
