---
/** The NUBI / BUILDS block-letter logo. Stacks into two rows on narrow containers. */
const NUBI = `███╗   ██╗██╗   ██╗██████╗ ██╗
████╗  ██║██║   ██║██╔══██╗██║
██╔██╗ ██║██║   ██║██████╔╝██║
██║╚██╗██║██║   ██║██╔══██╗██║
██║ ╚████║╚██████╔╝██████╔╝██║
╚═╝  ╚═══╝ ╚═════╝ ╚═════╝ ╚═╝`;

const BUILDS = `██████╗ ██╗   ██╗██╗██╗     ██████╗ ███████╗
██╔══██╗██║   ██║██║██║     ██╔══██╗██╔════╝
██████╔╝██║   ██║██║██║     ██║  ██║███████╗
██╔══██╗██║   ██║██║██║     ██║  ██║╚════██║
██████╔╝╚██████╔╝██║███████╗██████╔╝███████║
╚═════╝  ╚═════╝ ╚═╝╚══════╝╚═════╝ ╚══════╝`;
---

<div class="logo">
  <div class="row" role="img" aria-label="NubiBuilds" data-motion>
    {
      [
        { name: 'nubi', art: NUBI },
        { name: 'builds', art: BUILDS },
      ].map(({ name, art }) => (
        <div class:list={['art', name]} aria-hidden="true">
          <pre>{art}</pre>
          <div class="shine">
            <pre>{art}</pre>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .logo {
    container: logo / inline-size;
    padding: 8px 0 4px;
    overflow-x: auto;
  }
  .row {
    display: flex;
    align-items: flex-start;
  }
  .row {
    filter: var(--glow-drop);
  }
  .art {
    position: relative;
    /* Keeps the moving shine below from widening the scrollable logo. */
    overflow: clip;
  }
  pre {
    font-family: var(--font-ascii);
    font-size: min(22px, 2.15cqw);
    line-height: 1.2;
    white-space: pre;
  }
  .nubi {
    color: var(--accent);
    --shine: color-mix(in srgb, var(--accent) 45%, var(--hi));
  }
  .builds {
    color: var(--hi);
    --shine: color-mix(in srgb, var(--hi) 35%, var(--accent));
  }
  /*
   * A slow light sweep. A lighter copy of the letters shows through a soft window (.shine) that
   * slides across while the copy inside slides back by the same amount, so the letters stay put
   * and only the light moves. Both move by transform alone, which the compositor runs without
   * repainting the logo; animating a gradient's background-position repainted it every frame.
   */
  .shine {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .shine {
      display: block;
      position: absolute;
      inset: 0;
      overflow: clip;
      color: var(--shine);
      mask-image: linear-gradient(100deg, transparent 26%, #000 50%, transparent 74%);
      mask-repeat: no-repeat;
      pointer-events: none;
      user-select: none;
      transform: translateX(-106%);
      animation: sweep 7s ease-in-out 0.6s infinite;
    }
    .shine pre {
      transform: translateX(106%);
      animation: sweep-back 7s ease-in-out 0.6s infinite;
    }
    .builds .shine,
    .builds .shine pre {
      animation-delay: 0.9s;
    }
  }
  /* The window starts just off the left edge and ends just off the right, then rests. */
  @keyframes sweep {
    0% {
      transform: translateX(-106%);
    }
    45%,
    100% {
      transform: translateX(94%);
    }
  }
  @keyframes sweep-back {
    0% {
      transform: translateX(106%);
    }
    45%,
    100% {
      transform: translateX(-94%);
    }
  }
  @container logo (max-width: 620px) {
    .row {
      flex-direction: column;
    }
    pre {
      font-size: min(18px, 3.6cqw);
    }
  }
</style>
