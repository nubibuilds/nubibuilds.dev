---
import { principles } from '../data/about';
---

<div class="principles-wrap">
  <ol class="principles">
    {
      principles.map((p, i) => (
        <li style={`--c:${p.color}`}>
          <span class="num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="body">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  /* Width-aware: a stacked list in a narrow column, three columns when there's room. */
  .principles-wrap {
    container-type: inline-size;
  }
  .principles {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0 24px;
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }
  /* Coloured rule that sweeps across the top border on hover. */
  li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--c);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s ease;
  }
  li:hover::before {
    transform: scaleX(1);
  }

  .num {
    font-size: clamp(2.375rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--c);
    transition:
      color 0.3s,
      text-shadow 0.3s;
  }
  li:hover .num {
    color: var(--c);
    text-shadow: 0 0 22px color-mix(in srgb, var(--c) 45%, transparent);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h3 {
    font-size: 1.1875rem;
    line-height: 1.3;
    color: var(--hi);
  }
  p {
    max-width: 46ch;
    font-size: 0.90625rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  @container (min-width: 760px) {
    .principles {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0 40px;
      border-bottom: none;
    }
    li {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      gap: 20px;
      padding: 28px 0 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    li::before,
    .num {
      transition: none;
    }
  }
  @media (max-width: 411.98px) {
    li {
      gap: 0 16px;
      padding: 20px 0;
    }
    h3 {
      font-size: 1.0625rem;
    }
    p {
      font-size: 0.875rem;
    }
  }
</style>
