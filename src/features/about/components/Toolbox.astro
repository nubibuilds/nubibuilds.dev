---
/**
 * ~/toolbox as a file-explorer window: every directory is a folder card (tab, icon,
 * tree-drawn files) and a README.md tile closes the grid with the totals and a
 * GitHub-style bar of how the files split across folders.
 */
import { toolbox } from '../data/about';

/** "Next.js (route handlers)" → name + a quieter note, so long entries stay readable. */
const split = (tool: string) => {
  const m = tool.match(/^(.*?)\s*\((.*)\)$/);
  return m ? { name: m[1], note: m[2] } : { name: tool, note: '' };
};

const fileCount = toolbox.reduce((n, t) => n + t.tools.length, 0);
const share = toolbox.map((t) => ({
  dir: t.dir,
  color: t.color,
  n: t.tools.length,
  pct: Math.round((t.tools.length / fileCount) * 100),
}));
---

<div class="window">
  <div class="bar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <p class="title">~/toolbox</p>
    <p class="mode" aria-hidden="true">tree -L 2</p>
  </div>

  <ul class="grid">
    {
      toolbox.map((t) => (
        <li class="folder" style={`--c:${t.color}`}>
          <h3 class="tab">
            <svg class="icon" viewBox="0 0 20 16" aria-hidden="true">
              <path class="shut" d="M1.5 2.5a1 1 0 0 1 1-1h5l2 2h8a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1z" />
              <path class="open" d="M1.5 2.5a1 1 0 0 1 1-1h5l2 2h7a1 1 0 0 1 1 1V6M1.5 14.5V2.5M1.5 14.5h14.2a1 1 0 0 0 .95-.7L18.9 7a.8.8 0 0 0-.76-1H5.3a1 1 0 0 0-.95.7z" />
            </svg>
            <span class="name">{t.dir}/</span>
          </h3>
          <div class="body">
            <p class="info">
              <span>
                {t.tools.length} {t.tools.length === 1 ? 'file' : 'files'}
              </span>
              {'wip' in t && t.wip && <span class="wip">wip</span>}
            </p>
            <ul class="files">
              {t.tools.map((tool) => {
                const { name, note } = split(tool);
                return (
                  <li>
                    <span class="file">{name}</span>
                    {note && <span class="note">{note}</span>}
                  </li>
                );
              })}
            </ul>
            <span class="count" aria-hidden="true">
              {String(t.tools.length).padStart(2, '0')}
            </span>
          </div>
        </li>
      ))
    }

    <li class="readme">
      <h3 class="tab">
        <svg class="icon" viewBox="0 0 16 18" aria-hidden="true">
          <path d="M2.5 1.5h7l4 4v11h-11z M9.5 1.5v4h4 M5 9.5h6 M5 12.5h4" />
        </svg>
        <span class="name">README.md</span>
      </h3>
      <div class="body">
        <p class="md-h"># toolbox</p>
        <p class="total">
          <strong>{toolbox.length}</strong> directories, <strong>{fileCount}</strong> files
        </p>
        <div class="dist" aria-hidden="true" data-reveal>
          {share.map((s) => <span style={`--c:${s.color};flex:${s.n}`} />)}
        </div>
        <ul class="legend">
          {
            share.map((s) => (
              <li style={`--c:${s.color}`}>
                <span class="dot" aria-hidden="true" />
                <span class="dir">{s.dir}</span>
                <span class="pct">{s.pct}%</span>
              </li>
            ))
          }
        </ul>
      </div>
    </li>
  </ul>
</div>

<style>
  /* ---------- window ---------- */
  .window {
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: 0 30px 60px -40px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--bar);
    font-size: 0.8125rem;
  }
  .lights {
    display: flex;
    gap: 7px;
  }
  .lights i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--coral);
    opacity: 0.85;
  }
  .lights i:nth-child(2) {
    background: var(--amber);
  }
  .lights i:nth-child(3) {
    background: var(--accent);
  }
  .title {
    color: var(--hi);
  }
  .mode {
    justify-self: end;
    color: var(--dim);
  }

  .grid {
    --gap: 20px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
    gap: 34px var(--gap);
    margin: 0;
    padding: 46px 24px 26px;
    list-style: none;
    /* Faint dot grid, like the canvas under the loop diagram. */
    background: radial-gradient(color-mix(in srgb, var(--dim) 18%, transparent) 1px, transparent 1.5px) 0 0 / 18px 18px;
  }

  /* ---------- folder ---------- */
  .folder,
  .readme {
    --tint: color-mix(in srgb, var(--c) 14%, var(--surface));
    position: relative;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s var(--ease-out);
  }
  .readme {
    --c: var(--dim);
  }

  /* The tab sits on the folder's top edge; the slanted right side is what reads as "folder". */
  .tab {
    position: absolute;
    bottom: 100%;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    padding: 6px 30px 5px 12px;
    background: var(--tint);
    clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 100%, 0 100%);
    font-size: 0.84375rem;
    font-weight: 700;
    line-height: 1.125rem;
    color: var(--c);
  }
  .icon {
    flex: none;
    width: 17px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .icon path {
    transition: opacity 0.25s;
  }
  .icon .shut {
    fill: color-mix(in srgb, var(--c) 25%, transparent);
  }
  .icon .open {
    opacity: 0;
  }
  .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 18px 20px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-top: 2px solid var(--tint);
    background: linear-gradient(170deg, color-mix(in srgb, var(--c) 7%, var(--surface)), var(--surface) 55%);
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }

  .folder:hover,
  .readme:hover {
    transform: translateY(-4px);
  }
  .folder:hover .body,
  .readme:hover .body {
    border-color: color-mix(in srgb, var(--c) 45%, var(--line));
    border-top-color: var(--tint);
    box-shadow: 0 18px 36px -22px color-mix(in srgb, var(--c) 55%, transparent);
  }
  .folder:hover .icon .shut {
    opacity: 0;
  }
  .folder:hover .icon .open {
    opacity: 1;
  }

  .info {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .wip {
    padding: 0 6px;
    border: 1px solid color-mix(in srgb, var(--c) 50%, transparent);
    color: var(--c);
    letter-spacing: 0.06em;
  }
  .wip::after {
    content: '▍';
    margin-left: 2px;
  }

  /* Big outlined file count, tucked in the corner: fills short folders without noise. */
  .count {
    position: absolute;
    right: 12px;
    bottom: -10px;
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--c) 35%, transparent);
    pointer-events: none;
    transition:
      color 0.3s,
      -webkit-text-stroke-color 0.3s;
  }
  .folder:hover .count {
    color: color-mix(in srgb, var(--c) 10%, transparent);
    -webkit-text-stroke-color: var(--c);
  }

  /* ---------- files, drawn as a tree ---------- */
  .files {
    --row: 24px;
    --branch: color-mix(in srgb, var(--c) 35%, var(--line));
    position: relative;
    z-index: 1;
    margin: 0 0 0 5px;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  .files > li {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 3px 0 3px 22px;
    line-height: calc(var(--row) - 0.375rem);
  }
  .files > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 13px;
    height: calc(var(--row) / 2);
    border-left: 1px solid var(--branch);
    border-bottom: 1px solid var(--branch);
    border-bottom-left-radius: 5px;
  }
  .files > li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--row) / 2);
    bottom: 0;
    border-left: 1px solid var(--branch);
  }
  .file {
    color: var(--fg);
    transition:
      color 0.2s,
      transform 0.2s;
  }
  .files > li:hover .file {
    color: var(--c);
    transform: translateX(3px);
  }
  .note {
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--dim);
  }

  /* ---------- README ---------- */
  .readme .body {
    gap: 12px;
  }
  .md-h {
    font-weight: 700;
    color: var(--hi);
  }
  .total {
    font-size: 0.84375rem;
    color: var(--dim);
  }
  .total strong {
    color: var(--hi);
  }
  .dist {
    display: flex;
    gap: 3px;
    height: 8px;
    margin-top: 2px;
  }
  .dist span {
    background: var(--c);
    transform-origin: left;
  }
  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
    gap: 6px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.78125rem;
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c);
  }
  .legend .dir {
    color: var(--fg);
  }
  .legend .pct {
    color: var(--dim);
  }

  @media (prefers-reduced-motion: no-preference) {
    .wip::after {
      animation: blink 1.1s steps(1) infinite;
    }
    /* The distribution fills the first time it is seen (`data-reveal`, see global.css). */
    .dist:is([data-reveal='waiting'], [data-reveal='playing']) span {
      animation: fill 0.9s var(--ease-out) backwards;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes fill {
    from {
      transform: scaleX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .folder,
    .readme,
    .body,
    .icon path,
    .count,
    .file {
      transition: none;
    }
    .folder:hover,
    .readme:hover {
      transform: none;
    }
  }

  @media (max-width: 599.98px) {
    .mode {
      display: none;
    }
    .bar {
      grid-template-columns: auto 1fr;
    }
    .title {
      justify-self: center;
      margin-right: 44px;
    }
    .grid {
      gap: 32px var(--gap);
      padding: 40px 16px 20px;
    }
  }
  @media (max-width: 411.98px) {
    .grid {
      padding: 38px 12px 16px;
    }
    .body {
      padding: 14px 14px 18px;
    }
    .files {
      font-size: 0.84375rem;
    }
  }
</style>
