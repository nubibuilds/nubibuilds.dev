---
/**
 * "↑ top": a small button pinned to the bottom-right corner that scrolls back to the top of the
 * page. It shows once the page has been scrolled more than one screen down, so short pages never
 * show it. Without JavaScript it stays hidden (the Home and End keys do the same job).
 */
import { frameText } from '@shared/lib/i18n';

interface Props {
  /** Language of the page; the button's name follows it. */
  lang?: string;
}

const t = frameText(Astro.props.lang);
---

<!-- One screen below the top of the page: once it has scrolled above the screen, the button shows. -->
<div class="to-top-mark" data-to-top-mark aria-hidden="true"></div>
<button type="button" class="to-top" data-to-top hidden aria-label={t.backToTop}>
  <span aria-hidden="true">↑</span> top
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-to-top]');
  const mark = document.querySelector('[data-to-top-mark]');

  if (button && mark && 'IntersectionObserver' in window) {
    button.hidden = false;
    new IntersectionObserver(([entry]) => {
      const below = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      button.toggleAttribute('data-shown', below);
    }).observe(mark);

    button.addEventListener('click', (event) => {
      // `scroll-behavior` on <html> makes this smooth, and instant with reduced motion.
      window.scrollTo({ top: 0 });
      /*
       * The button hides at the top, so focus must not stay on it. From the keyboard (a click
       * with no pointer has detail 0), move it to the skip link, the first stop on the page:
       * the next Tab continues from the top, as after loading the page.
       */
      if (event.detail === 0) document.querySelector<HTMLElement>('a.skip')?.focus({ preventScroll: true });
      else button.blur();
    });
  }
</script>

<style>
  .to-top-mark {
    position: absolute;
    top: 100vh;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
  .to-top {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line);
    background: var(--bar);
    color: var(--dim);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    /* Hidden until the page is scrolled: out of the tab order and the accessibility tree too. */
    visibility: hidden;
    opacity: 0;
    translate: 0 12px;
    transition:
      opacity 0.2s,
      translate 0.2s var(--ease-out),
      visibility 0s 0.2s,
      color 0.15s,
      border-color 0.15s;
  }
  .to-top[hidden] {
    display: none;
  }
  .to-top[data-shown] {
    visibility: visible;
    opacity: 1;
    translate: none;
    transition:
      opacity 0.2s,
      translate 0.2s var(--ease-out),
      visibility 0s,
      color 0.15s,
      border-color 0.15s;
  }
  .to-top:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  @media (max-width: 411.98px) {
    .to-top {
      right: 12px;
      bottom: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .to-top,
    .to-top[data-shown] {
      translate: none;
      transition: none;
    }
  }
  @media print {
    .to-top {
      display: none;
    }
  }
</style>
