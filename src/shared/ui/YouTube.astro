---
/**
 * YouTube video that costs nothing until it is played: the page shows only a thumbnail
 * link, and the player (with YouTube's scripts) is loaded when the visitor clicks it.
 * Without JavaScript the link simply opens the video on YouTube.
 *
 * Usage in an .mdx file:
 *   import YouTube from '@shared/ui/YouTube.astro';
 *   <YouTube id="VIDEO_ID" title="What the video shows" />
 */
interface Props {
  /** The 11-character video id (the part after `v=` in the URL). */
  id: string;
  /** Describes the video; used as the accessible name and shown under the thumbnail. */
  title: string;
  /** Start position in seconds. */
  start?: number;
}

const { id, title, start } = Astro.props;
const watch = `https://www.youtube.com/watch?v=${id}${start ? `&t=${start}s` : ''}`;
const embed = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0${start ? `&start=${start}` : ''}`;
---

<a class="yt" href={watch} data-youtube={embed} data-title={title} aria-label={`Play video: ${title}`}>
  <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
  <span class="yt-play" aria-hidden="true">▶ play</span>
  <span class="yt-title">{title}</span>
</a>

<script>
  // One listener for every video on the page: swap the clicked thumbnail for the player.
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const link = target?.closest<HTMLAnchorElement>('a[data-youtube]');
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();

    const frame = document.createElement('iframe');
    frame.className = 'yt-frame';
    frame.src = link.dataset.youtube ?? '';
    frame.title = link.dataset.title ?? 'YouTube video';
    frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    frame.allowFullscreen = true;
    link.replaceWith(frame);
    frame.focus();
  });
</script>

<style is:global>
  .yt,
  .yt-frame {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .yt {
    position: relative;
    overflow: hidden;
    color: var(--hi);
    text-decoration: none;
  }
  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.75;
    transition: opacity 0.2s;
  }
  .yt:hover {
    border-color: var(--accent);
  }
  .yt:hover img {
    opacity: 1;
  }
  .yt-play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    border: 1px solid var(--accent);
    background: var(--bg);
    color: var(--accent);
    font-weight: 700;
    transform: translate(-50%, -50%);
  }
  .yt:hover .yt-play {
    background: var(--accent);
    color: var(--on-accent);
  }
  .yt-title {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 10px 14px;
    border-top: 1px solid var(--line);
    background: var(--bar);
    color: var(--fg);
    font-size: 0.84375rem;
  }
</style>
