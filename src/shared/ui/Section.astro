---
/**
 * Full-width page band. Put <Rain> / <Marquee> in the "ornament" slot to get a
 * moving background; the default slot is centred at page width above it.
 */
interface Props {
  id?: string;
  bordered?: boolean;
  narrow?: boolean;
}

const { id, bordered = true, narrow = false } = Astro.props;
---

<section id={id} class:list={['section', { bordered }]}>
  {
    Astro.slots.has('ornament') && (
      <div class="orn" aria-hidden="true">
        <slot name="ornament" />
      </div>
    )
  }
  <div class:list={['wrap', { narrow }]}>
    <slot />
  </div>
</section>

<style>
  .section {
    position: relative;
    /*
     * Keep ornaments inside the band. `clip` (not `hidden`) on purpose: `hidden` turns the
     * section into a scroll container, which stops `position: sticky` children (the contents
     * lists) from sticking to the viewport. `hidden` stays as the fallback for old browsers.
     */
    overflow: hidden;
    overflow: clip;
  }
  /*
   * No `content-visibility: auto` here, on purpose. It was tried: sections laid out late swapped a
   * height estimate for their real height while scrolling (the page grew by up to ~1,500px on a
   * phone), and each one coming back on screen had to be painted again, which made scrolling choppy.
   */
  .bordered {
    border-top: 1px dashed var(--line);
  }
  .orn {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    opacity: var(--orn);
    color: var(--accent);
    font-family: var(--font-ascii);
    contain: strict;
  }
  /* Hidden until the page is parsed (class set in BaseLayout), so the ornaments never jump into place. */
  :global(html.orn-wait) .orn {
    visibility: hidden;
  }
  @media (max-width: 411.98px) {
    .orn {
      opacity: calc(var(--orn) * 0.7);
    }
  }
</style>
