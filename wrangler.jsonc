{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nubibuilds",
  "compatibility_date": "2026-11-22",
  // Static site: Astro builds to dist/, served as Workers static assets (no Worker script).
  // Headers come from public/_headers.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Cloudflare creates the DNS record and certificate for this domain on deploy.
  "routes": [{ "pattern": "nubibuilds.dev", "custom_domain": true }],
  // Serve only on nubibuilds.dev, so the site has no second, duplicate address.
  "workers_dev": false,
  "preview_urls": false
}
